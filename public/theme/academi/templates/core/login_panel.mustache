{{!
    @template core/login_panel

    Default content for the left panel of the split-screen login layout.

    When leftinstructions is provided (i.e. the site has custom auth instructions configured),
    it fully replaces the entire default welcome section (title, tagline, and stats).

    Example context (json):
    {
        "leftinstructions": "<p>Welcome to our learning platform. Please log in to continue.</p>"
    }
}}
{{^leftinstructions}}
    {{#showdefaultloginpanel}}
        <div class="login-layout-left-content">
            <h1 style="font-size: 33px;" class="mb-3"><strong>Welcome to LearningPlex</strong></h1>

            <div style="text-align: center;">
                GSFC University's Learning Management System
            </div> 
            <p class="mx-auto mb-4">
                Learn. Engage. Excel.
            </p>

            <div class="login-layout-stats">
                <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                    <strong class="login-layout-stat-value">
                        {{learningplex_registeredusers}}
                    </strong>
                    <span>Users</span>
                </div>

               

                <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                    <strong class="login-layout-stat-value">
                        {{learningplex_teachers}}
                    </strong>
                    <span>Faculty</span>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                <strong class="login-layout-stat-value">
                    {{learningplex_totalstudents}}
                </strong>
                <span>Students</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                <strong class="login-layout-stat-value">
                    {{learningplex_visitingfaculty}}
                </strong>
                <span>Visiting Faculty</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                    <strong class="login-layout-stat-value">
                        {{learningplex_totalcourses}}
                    </strong>
                    <span>Total Courses</span>
                </div>
             <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem;">
                    <strong class="login-layout-stat-value">
                        {{learningplex_visiblecourses}}
                    </strong>
                    <span>Active Courses</span>
                </div>
            </div>
        </div>
    {{/showdefaultloginpanel}}
{{/leftinstructions}}
{{#leftinstructions}}
    <div class="login-layout-left-content">
        <div class="mx-auto text-start">
            {{{leftinstructions}}}
        </div>
    </div>
{{/leftinstructions}}

